{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ecl-automation-tool",
  "version": "0.1.0",
  "identifier": "com.yourname.ecl-automation-tool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ASA PHILIPPINES",
        "width": 1600,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
"bundle": {
  "active": true,
  "targets": "all",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ],
  "windows": {
    "allowDowngrades": true,
    "certificateThumbprint": null,
    "digestAlgorithm": null,
    "nsis": {
      "languages": ["English"]
    },
    "signCommand": null,
    "timestampUrl": null,
    "tsp": false,
    "webviewInstallMode": {
      "silent": true,
      "type": "downloadBootstrapper"
    },
    "wix": {
      "language": "en-US"
    }
  },
  "resources": ["../server"]
},
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDQTNENjY0MDQ4NkRBNEUKUldSTzJvWUVaTmFqTEhNRkh5WUFxN2kzZG5qUFdFM2lKMEpGQklxM1VNVTVDTlZ6NnBsbmtCMzAK",
      "endpoints": [
        "https://intelligoblob.blob.core.windows.net/ecl-tauri-installers/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
